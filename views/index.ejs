<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= taller.nombre %></title>
  <link rel="stylesheet" href="/public/estilos.css">
</head>
<body>
  <main class="container">
    <a href="/talleres">← Volver al catálogo</a>

    <section class="detalle">
      <h1><%= taller.nombre %></h1>
      <p><%= taller.descripcion %></p>
      <p><strong>Plazas restantes:</strong> <%= plazasRestantes %></p>
    </section>

    <hr>

    <section class="formulario-section">
      <h2>Inscripción al taller</h2>

      <form action="/talleres/<%= taller.id %>/inscripcion" method="POST" novalidate>
        
        <!-- Campo Nombre -->
        <div class="form-group">
          <label for="nombre">Nombre completo:</label>
          <input 
            type="text" 
            id="nombre" 
            name="nombre" 
            value="<%= valores.nombre || '' %>"
          >
          <% if (errores.nombre) { %>
            <span class="error"><%= errores.nombre %></span>
          <% } %>
        </div>

        <!-- Campo Email -->
        <div class="form-group">
          <label for="email">Correo electrónico:</label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            value="<%= valores.email || '' %>"
          >
          <% if (errores.email) { %>
            <span class="error"><%= errores.email %></span>
          <% } %>
        </div>

        <button type="submit" class="btn">Inscribirme</button>
      </form>
    </section>
  </main>
</body>
</html>