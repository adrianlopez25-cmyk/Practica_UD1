<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Catálogo de Talleres</title>
  <link rel="stylesheet" href="/estilos.css">
</head>
<body>
  <main class="container">
    <h1>Talleres Disponibles</h1>

    <div class="talleres-grid">
      <% talleres.forEach(taller => { %>
        <article class="taller-card">
          <h2><%= taller.titulo %></h2> 
          
          <p><%= taller.resumen %></p> 

          <% if (typeof taller.plazasRestantes !== 'undefined') { %>
            <p>
              <strong>Plazas restantes:</strong> <%= taller.plazasRestantes %>
              <% if (taller.plazasRestantes === 1) { %>
                <span style="color: #d9534f; font-weight: bold; margin-left: 5px;">⚠️ ¡Última plaza!</span>
              <% } else if (taller.plazasRestantes === 0) { %>
                <span style="color: #6c757d; font-style: italic; margin-left: 5px;">(Completo)</span>
              <% } %>
            </p>
          <% } %>
          
          <a href="/talleres/<%= taller.id %>" class="btn">Ver detalle e inscribirme</a>
        </article>
      <% }); %>
    </div>
  </main>
</body>
</html>